# The Qt that quickshell itself was built against. The tooling has to use the
# same one: its qmltypes are generated by that Qt, and a qmllint from any other
# version reads them differently.
{ lib, quickshell }:
let
  # buildInputs hold the -dev outputs; tools and qml modules live in out
  find =
    pname:
    (lib.findFirst (
      p: (p.pname or null) == pname
    ) (throw "quickshell has no ${pname} in buildInputs") quickshell.buildInputs).out;
in
{
  qtbase = find "qtbase";
  qtdeclarative = find "qtdeclarative";
}
